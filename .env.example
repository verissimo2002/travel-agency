# Configurações da Aplicação
APP_NAME=Travel Agency Document Processor
APP_VERSION=1.0.0
DEBUG=False

# Banco de Dados
DATABASE_FILE=viagens.db
DATABASE_URL=sqlite:///./viagens.db

# Segurança
ZIP_PASSWORD=Angola2019@
SECRET_KEY=sua-chave-secreta-aqui-mude-em-producao

# Upload
UPLOAD_DIR=./uploads
TEMP_DIR=./temp
MAX_UPLOAD_SIZE=52428800  # 50MB em bytes

# Servidor
HOST=0.0.0.0
PORT=8000
WORKERS=4

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Email (Opcional - para notificações)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log
